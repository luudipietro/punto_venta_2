APP_NAME="POS Backend"
DEBUG=false

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# To switch to MySQL: mysql+aiomysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos

# Used to sign login session tokens (JWT) — set a real random secret in production.
SECRET_KEY=dev-secret-change-me
