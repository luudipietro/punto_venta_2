APP_NAME="POS Backend"
DEBUG=false

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# To switch to MySQL: mysql+aiomysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos

# Used to sign login session tokens (JWT). Anyone who knows this value can forge
# a valid login for any user without a password — the placeholder below is
# fine for a local checkout only, never for anything reachable by anyone else.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
