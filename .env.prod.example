# Copy this to .env.prod on the server and fill in real values.
# Never commit .env.prod with real secrets.

POSTGRES_USER=pos
POSTGRES_PASSWORD=changeme-use-a-strong-password
POSTGRES_DB=pos

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-secret

# The server's public IP — used as a CORS fallback so the backend stays
# reachable by IP even after a domain is configured.
SERVER_IP=your.server.ip.here

# The public domain this instance is served under (e.g. tienda1.cajerox.com).
# Used to build CORS_ORIGINS. Must match the server_name in the host Nginx
# config and the -d flag passed to certbot.
DOMAIN=tienda1.cajerox.com

# Host-only port the frontend container's Nginx listens on (127.0.0.1 only,
# not exposed to the internet directly). The host Nginx reverse-proxies
# DOMAIN to this port. Give each additional client instance its own port
# (8082, 8083, ...).
FRONTEND_PORT=8081

# Optional: the public customer-facing catalog (storefront/), a separate
# subdomain with no login (e.g. catalogo.tienda1.cajerox.com). Leave unset
# until this client actually wants the online catalog — the `storefront`
# service in docker-compose.prod.yml still builds either way, it just won't
# be reachable from the internet without its own host Nginx site block +
# certbot cert, same as DOMAIN/FRONTEND_PORT above.
STOREFRONT_DOMAIN=catalogo.tienda1.cajerox.com
STOREFRONT_PORT=8091
